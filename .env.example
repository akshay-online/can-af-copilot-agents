# Copy to .env (git-ignored). Never commit .env and never paste its values into chat.
# Host, project and issue type live in config/jira.config.json; only secrets go here.

# Jira Cloud: your Atlassian email + an API token (id.atlassian.com > Security > API tokens)
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Server / Data Center: a Personal Access Token (leave the two lines above empty)
JIRA_PAT=

# Optional. Overrides base_url in config/jira.config.json (kept for the existing jira_fetch.py)
# JIRA_BASE_URL=https://your-company.atlassian.net
